rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /trips/{tripId} {
      // allow read, update, delete if the document's userId matches auth.uid
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // allow create if the new document's userId matches auth.uid
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /enclosures/{enclosureId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /observations/{observationId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
  }
}
